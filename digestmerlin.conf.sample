# DigestMerlin settings - the menu (sh /jffs/scripts/digestmerlin.sh) edits them for you.
# Every line is optional: the values below are the defaults.
# To edit by hand: copy to /jffs/addons/digestmerlin.d/digestmerlin.conf

# Sections to leave out, by name (skynet diversion vpn speedtest backupmon devices system)
DISABLED_SECTIONS=""

# Text added in front of the e-mail subject, e.g. "[Home] "
SUBJECT_PREFIX=""

# VPN: alert when a WireGuard client has had no handshake for this long (seconds)
WG_HANDSHAKE_MAX=600

# spdMerlin: alert when the newest result is older than this (hours)
SPEEDTEST_MAX_AGE_H=25

# BACKUPMON: alert when the last NVRAM backup is older than this (hours)
BACKUP_MAX_AGE_H=26

# New devices: 1 = ignore random "private" MAC addresses used by phones/laptops
DEVICES_IGNORE_PRIVATE_MAC=0

# System: alert when /jffs or the USB drive is this full (%)
DISK_ALERT_PCT=90

# System: alert when the router has not rebooted for this many days (empty = off)
REBOOT_MAX_DAYS=""

# System: alert when the CPU temperature reaches this value in C (empty = off)
CPU_TEMP_ALERT=""

# System: WAN drops that start in this window are shown but raise no alert,
# e.g. during a scheduled modem reboot - "Sun 03:00-03:10" (empty = none)
WAN_PLANNED=""

# The digest says when a new DigestMerlin version is on GitHub (1 = check, 0 = never)
UPDATE_CHECK=1
